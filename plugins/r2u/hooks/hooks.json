{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/r2u_hook_run.sh SessionStart",
            "command_windows": "${PLUGIN_ROOT}\\hooks\\r2u_hook_run.bat SessionStart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/r2u_hook_run.sh PreToolUse",
            "command_windows": "${PLUGIN_ROOT}\\hooks\\r2u_hook_run.bat PreToolUse"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/r2u_hook_run.sh PermissionRequest",
            "command_windows": "${PLUGIN_ROOT}\\hooks\\r2u_hook_run.bat PermissionRequest"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/r2u_hook_run.sh PostToolUse",
            "command_windows": "${PLUGIN_ROOT}\\hooks\\r2u_hook_run.bat PostToolUse",
            "statusMessage": "Reviewing Bash output"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
