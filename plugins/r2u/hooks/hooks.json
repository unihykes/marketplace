    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/r2u_hook_run.sh PostCompact",
            "command_windows": "${PLUGIN_ROOT}\\hooks\\r2u_hook_run.bat PostCompact"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/r2u_hook_run.sh UserPromptSubmit",
            "command_windows": "${PLUGIN_ROOT}\\hooks\\r2u_hook_run.bat UserPromptSubmit"
          }
