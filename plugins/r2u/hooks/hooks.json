          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/r2u_hook_run.sh Stop",
            "command_windows": "${PLUGIN_ROOT}\\hooks\\r2u_hook_run.bat Stop"
